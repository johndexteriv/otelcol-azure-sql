# Collector selection
COLLECTOR_PROFILE=managed-identity

# groundcover OTLP/HTTP. Use the full HTTPS base URL; do not append /v1/metrics.
GROUNDCOVER_OTLP_ENDPOINT=https://<GROUNDCOVER_OTLP_HOST>
GROUNDCOVER_INGESTION_KEY=<GROUNDCOVER_INGESTION_KEY>
GROUNDCOVER_ENV_NAME=<ENVIRONMENT_NAME>
GROUNDCOVER_SERVICE_NAME=<SERVICE_NAME>

# Optional user-assigned managed identity. Leave empty for system-assigned identity.
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# Used only by the documented stock-Collector SQL-auth fallback.
SQL_USERNAME=<SQL_READER_USERNAME>
SQL_PASSWORD=<SQL_READER_PASSWORD>

# Query schedule
SQL_COLLECTION_INTERVAL=60s

# Pinned release inputs. The custom version includes this distribution's patch revision.
CUSTOM_COLLECTOR_VERSION=0.158.0-groundcover.2
STOCK_COLLECTOR_VERSION=0.158.0
COLLECTOR_RELEASE_REPOSITORY=johndexteriv/otelcol-azure-sql
